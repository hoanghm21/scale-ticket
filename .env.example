# ========================
# Environment Variables
# ========================

# ── General ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scaleticket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scaleticket
DATABASE_URL=postgresql://scaleticket:changeme@localhost:5432/scaleticket

# ── MongoDB ──
MONGODB_URL=mongodb://localhost:27017/scaleticket_events

# ── Redis ──
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT / Auth ──
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── gRPC ──
GRPC_AUTH_SERVICE=localhost:50051
GRPC_EVENT_SERVICE=localhost:50052
GRPC_TICKET_SERVICE=localhost:50053

# ── Socket.IO ──
SOCKET_IO_PORT=3001
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# ── Payment (Stripe) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Email / Notifications ──
# Leave SMTP_HOST empty for local dev to auto-create Ethereal test inbox
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=ScaleTicket <no-reply@scaleticket.local>
PUSH_NOTIFICATION_KEY=your-push-key

# ── S3 / File Storage ──
S3_BUCKET=scaleticket-assets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
